# Supabase の接続情報
#
# このファイルをコピーして .env.local を作り、実際の値を入れてください。
#   cp .env.local.example .env.local
#
# 値は Supabase の管理画面 → Project Settings → API から取得できます。
# .env.local は Git にコミットされません（.gitignore 済み）。
#
# 未設定のままでも、新着情報は src/lib/content.ts の仮データで表示されます。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Gmail の送信設定（npm run setup:gmail で自動生成できます）
#   GMAIL_APP_PASSWORD は Googleアカウント → セキュリティ → 2段階認証プロセス →
#   アプリ パスワード で発行する16桁の文字列。ログインパスワードではありません。
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
NOTIFY_EMAIL=you@gmail.com

# 既存生徒用「授業のお申し込み」ページの秘密のURL（/lesson/この値）。
# 推測されにくいランダムな文字列にする。例：node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# 未設定のときは授業の申し込みページは表示されない（404）。
LESSON_FORM_TOKEN=
